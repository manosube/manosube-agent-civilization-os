{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/observation/normalized_fact.schema.json", "type": "object",
  "required": ["schema_version", "fact_id", "project_id", "subject", "predicate", "value", "value_type", "unit", "effective_boundary", "normalization_profile"],
  "properties": {"schema_version": {"const": "0.1"}, "fact_id": {"$ref": "../common/identity.schema.json"}, "project_id": {"$ref": "../common/identity.schema.json"}, "subject": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*@v[0-9]+$"}, "value": {}, "value_type": {"enum": ["NULL", "BOOLEAN", "INTEGER", "DECIMAL", "STRING", "TIMESTAMP", "DURATION", "IDENTITY_REFERENCE", "ORDERED_COLLECTION", "UNORDERED_COLLECTION", "STRUCTURED"]}, "unit": {"type": ["string", "null"]}, "effective_boundary": {"type": "object", "required": ["kind", "identity", "start", "end"], "properties": {"kind": {"enum": ["TIME_INTERVAL", "STATE_REVISION", "SOURCE_SNAPSHOT"]}, "identity": {"type": "string", "minLength": 1}, "start": {"type": ["string", "integer", "null"]}, "end": {"type": ["string", "integer", "null"]}}, "additionalProperties": false}, "normalization_profile": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]*-[0-9]+\\.[0-9]+$"}},
  "allOf": [
    {"if": {"properties": {"value_type": {"const": "NULL"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "null"}}}},
    {"if": {"properties": {"value_type": {"const": "BOOLEAN"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "boolean"}}}},
    {"if": {"properties": {"value_type": {"const": "INTEGER"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "integer"}}}},
    {"if": {"properties": {"value_type": {"const": "DECIMAL"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}}}},
    {"if": {"properties": {"value_type": {"enum": ["STRING", "DURATION"]}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "string"}}}},
    {"if": {"properties": {"value_type": {"const": "TIMESTAMP"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"$ref": "../common/timestamp.schema.json"}}}},
    {"if": {"properties": {"value_type": {"const": "IDENTITY_REFERENCE"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"$ref": "../common/reference.schema.json"}}}},
    {"if": {"properties": {"value_type": {"enum": ["ORDERED_COLLECTION", "UNORDERED_COLLECTION"]}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "array"}}}},
    {"if": {"properties": {"value_type": {"const": "STRUCTURED"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "object"}}}}
  ], "additionalProperties": false
}
