{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/observation/fact_evaluation.schema.json", "type": "object",
  "required": ["schema_version", "evaluation_id", "fact_id", "evaluation_revision", "previous_evaluation_id", "binding_refs", "evaluation_status", "conflict_fact_refs", "conflict_negative_observation_refs", "evidence_refs"],
  "properties": {"schema_version": {"const": "0.1"}, "evaluation_id": {"$ref": "../common/identity.schema.json"}, "fact_id": {"$ref": "../common/identity.schema.json"}, "evaluation_revision": {"type": "integer", "minimum": 0}, "previous_evaluation_id": {"oneOf": [{"type": "null"}, {"$ref": "../common/identity.schema.json"}]}, "binding_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "evaluation_status": {"enum": ["SUPPORTED", "UNKNOWN", "INCOMPLETE", "BLOCKED", "INVALID", "CONFLICTED"]}, "conflict_fact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "conflict_negative_observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}},
  "allOf": [{"if": {"properties": {"evaluation_revision": {"const": 0}}, "required": ["evaluation_revision"]}, "then": {"properties": {"previous_evaluation_id": {"type": "null"}}}, "else": {"properties": {"previous_evaluation_id": {"$ref": "../common/identity.schema.json"}}}}, {"if": {"properties": {"evaluation_status": {"const": "CONFLICTED"}}, "required": ["evaluation_status"]}, "then": {"anyOf": [{"properties": {"conflict_fact_refs": {"minItems": 1}}}, {"properties": {"conflict_negative_observation_refs": {"minItems": 1}}}]}}], "additionalProperties": false
}
