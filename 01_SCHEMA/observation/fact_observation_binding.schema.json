{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/observation/fact_observation_binding.schema.json", "type": "object",
  "required": ["schema_version", "binding_id", "fact_id", "observation_id", "state_revision_observed", "state_fingerprint_observed", "source_occurrence_id", "source_ref", "source_locator", "observed_quality_status"],
  "properties": {"schema_version": {"const": "0.1"}, "binding_id": {"$ref": "../common/identity.schema.json"}, "fact_id": {"$ref": "../common/identity.schema.json"}, "observation_id": {"$ref": "../common/identity.schema.json"}, "state_revision_observed": {"type": "integer", "minimum": 0}, "state_fingerprint_observed": {"$ref": "../common/fingerprint.schema.json"}, "source_occurrence_id": {"$ref": "../common/identity.schema.json"}, "source_ref": {"$ref": "../common/reference.schema.json"}, "source_locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*(?:password|token|secret|credential))[^\\r\\n]+$"}, "observed_quality_status": {"enum": ["SUPPORTED", "UNKNOWN", "INCOMPLETE", "BLOCKED", "INVALID", "CONFLICTED"]}}, "additionalProperties": false
}
