{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/observation/negative_observation.schema.json", "type": "object",
  "required": ["schema_version", "negative_observation_id", "observation_id", "project_id", "target_identity", "subject", "predicate", "effective_boundary", "negative_status", "scope_ref", "method_ref", "time_boundary", "source_snapshot_refs", "attempt_refs", "completion_evaluation", "blind_spot_refs", "negative_evidence_refs", "positive_fact_refs", "conclusion"],
  "properties": {"schema_version": {"const": "0.1"}, "negative_observation_id": {"$ref": "../common/identity.schema.json"}, "observation_id": {"$ref": "../common/identity.schema.json"}, "project_id": {"$ref": "../common/identity.schema.json"}, "target_identity": {"$ref": "../common/identity.schema.json"}, "subject": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*@v[0-9]+$"}, "effective_boundary": {"$ref": "normalized_fact.schema.json#/properties/effective_boundary"}, "negative_status": {"enum": ["ABSENT", "EMPTY", "NO_RESULT", "UNKNOWN", "UNOBSERVED", "BLOCKED", "INCOMPLETE", "FAILED", "INVALID", "CONFLICTED"]}, "scope_ref": {"$ref": "../common/reference.schema.json"}, "method_ref": {"$ref": "../common/reference.schema.json"}, "time_boundary": {"$ref": "observation.schema.json#/properties/time_boundary"}, "source_snapshot_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "attempt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "completion_evaluation": {"type": "object", "required": ["target_defined", "scope_complete", "method_complete", "time_boundary_complete", "source_snapshots_identified", "required_attempts_completed", "no_blocking_blind_spot", "no_conflicting_positive_fact"], "properties": {"target_defined": {"type": "boolean"}, "scope_complete": {"type": "boolean"}, "method_complete": {"type": "boolean"}, "time_boundary_complete": {"type": "boolean"}, "source_snapshots_identified": {"type": "boolean"}, "required_attempts_completed": {"type": "boolean"}, "no_blocking_blind_spot": {"type": "boolean"}, "no_conflicting_positive_fact": {"type": "boolean"}}, "additionalProperties": false}, "blind_spot_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "negative_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "positive_fact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}}, "conclusion": {"type": "object", "required": ["state_candidate", "reason"], "properties": {"state_candidate": {"enum": ["ABSENT", "EMPTY", "UNKNOWN", "UNOBSERVED", "BLOCKED", "INCOMPLETE", "CONFLICTED", "REJECT_OR_QUARANTINE"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
  "allOf": [
    {"if": {"properties": {"negative_status": {"const": "ABSENT"}}, "required": ["negative_status"]}, "then": {"properties": {"source_snapshot_refs": {"minItems": 1}, "attempt_refs": {"minItems": 1}, "negative_evidence_refs": {"minItems": 1}, "positive_fact_refs": {"maxItems": 0}, "completion_evaluation": {"properties": {"target_defined": {"const": true}, "scope_complete": {"const": true}, "method_complete": {"const": true}, "time_boundary_complete": {"const": true}, "source_snapshots_identified": {"const": true}, "required_attempts_completed": {"const": true}, "no_blocking_blind_spot": {"const": true}, "no_conflicting_positive_fact": {"const": true}}}, "conclusion": {"properties": {"state_candidate": {"const": "ABSENT"}}}}}},
    {"if": {"properties": {"negative_status": {"const": "NO_RESULT"}}, "required": ["negative_status"]}, "then": {"properties": {"conclusion": {"properties": {"state_candidate": {"const": "UNKNOWN"}}}}}},
    {"if": {"properties": {"negative_status": {"const": "INVALID"}}, "required": ["negative_status"]}, "then": {"properties": {"conclusion": {"properties": {"state_candidate": {"const": "REJECT_OR_QUARANTINE"}}}}}},
    {"if": {"properties": {"negative_status": {"const": "CONFLICTED"}}, "required": ["negative_status"]}, "then": {"properties": {"positive_fact_refs": {"minItems": 1}, "conclusion": {"properties": {"state_candidate": {"const": "CONFLICTED"}}}}}}
  ], "additionalProperties": false
}
