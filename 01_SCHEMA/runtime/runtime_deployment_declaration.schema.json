{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/runtime/runtime_deployment_declaration.schema.json",
  "title": "Canonical Runtime Deployment Declaration",
  "type": "object",
  "required": [
    "schema_version",
    "runtime_deployment_declaration_id",
    "runtime_deployment_declaration_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "provider",
    "deployment_id",
    "instance_identity",
    "deployment_fingerprint",
    "human_authority_ref",
    "status",
    "declared_at",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "runtime_deployment_declaration_id": {
      "type": "string",
      "pattern": "^RUNTIME-DEPLOYMENT-DECLARATION-[0-9A-F]{64}(?![\\s\\S])"
    },
    "runtime_deployment_declaration_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "provider": {"type": "string", "minLength": 1, "maxLength": 64},
    "deployment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "instance_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "deployment_fingerprint": {"type": "string", "minLength": 1, "maxLength": 256},
    "human_authority_ref": {"$ref": "../common/reference.schema.json"},
    "status": {"enum": ["ACTIVE", "REVOKED"]},
    "declared_at": {"$ref": "../common/timestamp.schema.json"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"$ref": "../common/identity.schema.json"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{128}(?![\\s\\S])"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
