{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/runtime/runtime_root_admission.schema.json",
  "title": "Canonical Runtime Root Admission",
  "type": "object",
  "required": [
    "schema_version",
    "runtime_root_admission_id",
    "runtime_root_admission_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "status",
    "declared_at",
    "generation",
    "predecessor_ref",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "runtime_root_admission_id": {
      "type": "string",
      "pattern": "^RUNTIME-ROOT-ADMISSION-[0-9A-F]{64}(?![\\s\\S])"
    },
    "runtime_root_admission_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "status": {"enum": ["ACTIVE", "REVOKED"]},
    "declared_at": {"$ref": "../common/timestamp.schema.json"},
    "generation": {"type": "integer", "minimum": 0},
    "predecessor_ref": {"$ref": "#/$defs/predecessor_ref"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "predecessor_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "allOf": [
            {"$ref": "../common/reference.schema.json"},
            {"properties": {"kind": {"const": "runtime_root_admission"}}}
          ]
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"$ref": "../common/identity.schema.json"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{128}(?![\\s\\S])"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
