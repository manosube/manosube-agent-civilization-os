{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/comparative_benchmark/comparative_benchmark_protocol_freeze.schema.json",
  "title": "Phase 21 Comparative Benchmark: immutable pre-result protocol freeze (Issue #89, ADOPT_PHASE_21_COMPARATIVE_BENCHMARK)",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_freeze_id",
    "protocol_freeze_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "corpus_manifest",
    "comparison_groups",
    "authority_boundary_equivalence_manifest",
    "resource_budget_manifest",
    "metric_definitions",
    "numeric_thresholds",
    "unknown_missing_handling",
    "exclusion_policy",
    "claim_vocabulary",
    "reproduction_procedure",
    "comparability_loss_receipts",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "protocol_freeze_id": {"$ref": "#/$defs/protocol_freeze_id"},
    "protocol_freeze_semantic_fingerprint": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "corpus_manifest": {
      "type": "object",
      "required": ["corpus_kind", "task_count", "task_ids"],
      "properties": {
        "corpus_kind": {"const": "comparative_benchmark"},
        "task_count": {"type": "integer", "minimum": 1},
        "task_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "comparison_groups": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["comparison_group_id", "comparison_group_role", "mechanism_identity", "agent_label"],
        "properties": {
          "comparison_group_id": {"type": "string", "minLength": 1},
          "comparison_group_role": {"enum": ["MANOSUBE_PRESENT", "MANOSUBE_ABSENT"]},
          "mechanism_identity": {
            "type": "object",
            "required": ["mechanism", "version"],
            "properties": {
              "mechanism": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "agent_label": {
            "type": "object",
            "required": ["agent_family", "version"],
            "properties": {
              "agent_family": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "authority_boundary_equivalence_manifest": {
      "type": "object",
      "required": ["boundary_ref", "equivalence_statement"],
      "properties": {
        "boundary_ref": {"$ref": "../common/reference.schema.json"},
        "equivalence_statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "resource_budget_manifest": {
      "type": "object",
      "required": ["per_task_timeout_seconds", "total_time_budget_seconds"],
      "properties": {
        "per_task_timeout_seconds": {"type": "string", "minLength": 1},
        "total_time_budget_seconds": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metric_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_name", "formula", "denominator"],
        "properties": {
          "metric_name": {"type": "string", "minLength": 1},
          "formula": {"type": "string", "minLength": 1},
          "denominator": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "numeric_thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_name", "comparison_decision_rule"],
        "properties": {
          "metric_name": {"type": "string", "minLength": 1},
          "comparison_decision_rule": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "unknown_missing_handling": {
      "type": "object",
      "required": ["unknown_ne_zero", "refusal_ne_system_failure", "retained_ne_closed"],
      "properties": {
        "unknown_ne_zero": {"const": true},
        "refusal_ne_system_failure": {"const": true},
        "retained_ne_closed": {"const": true}
      },
      "additionalProperties": false
    },
    "exclusion_policy": {
      "type": "object",
      "required": ["success_only_subset_forbidden", "post_hoc_protocol_mutation_forbidden", "raw_result_deletion_forbidden"],
      "properties": {
        "success_only_subset_forbidden": {"const": true},
        "post_hoc_protocol_mutation_forbidden": {"const": true},
        "raw_result_deletion_forbidden": {"const": true}
      },
      "additionalProperties": false
    },
    "claim_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_statement_template", "bound"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_statement_template": {"type": "string", "minLength": 1},
          "bound": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reproduction_procedure": {
      "type": "object",
      "required": ["entrypoint", "corpus_kind"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "corpus_kind": {"const": "comparative_benchmark"}
      },
      "additionalProperties": false
    },
    "comparability_loss_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["receipt_id", "description"],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "generated_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "protocol_freeze_id": {"type": "string", "pattern": "^CBPF-[0-9A-F]{64}(?![\\s\\S])"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
  },
  "additionalProperties": false
}
