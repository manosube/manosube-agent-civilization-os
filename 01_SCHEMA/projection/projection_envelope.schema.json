{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/projection/projection_envelope.schema.json",
  "title": "Canonical Projection Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "projection_envelope_id",
    "projection_envelope_semantic_fingerprint",
    "subject_ref",
    "subject_fingerprint",
    "projection_kind",
    "target_repository",
    "projection_payload",
    "projection_payload_fingerprint",
    "external_artifact_ref",
    "github_authority_ref",
    "materialized_at",
    "claim_token"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "projection_envelope_id": {"$ref": "../common/identity.schema.json"},
    "projection_envelope_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "subject_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"enum": ["difference", "change", "observation_evidence"]}}}
      ]
    },
    "subject_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "projection_kind": {
      "enum": ["DIFFERENCE_ISSUE", "CHANGE_PULL_REQUEST", "EVIDENCE_ARTIFACT"]
    },
    "target_repository": {
      "type": "object",
      "required": ["host", "owner", "repo"],
      "properties": {
        "host": {"const": "github"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "repo": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "projection_payload": {},
    "projection_payload_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "external_artifact_ref": {
      "type": "object",
      "required": ["host", "owner", "repo", "artifact_kind", "external_id", "url"],
      "properties": {
        "host": {"const": "github"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "repo": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_kind": {
          "enum": ["issue", "pull_request", "check_run", "review", "artifact"]
        },
        "external_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "url": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "additionalProperties": false
    },
    "github_authority_ref": {"$ref": "../common/reference.schema.json"},
    "materialized_at": {"$ref": "../common/timestamp.schema.json"},
    "claim_token": {"$ref": "../common/identity.schema.json"}
  },
  "additionalProperties": false
}
