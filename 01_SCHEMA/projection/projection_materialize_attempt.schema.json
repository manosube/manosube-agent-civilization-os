{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/projection/projection_materialize_attempt.schema.json",
  "title": "Projection Materialize Attempt (durable pre-write marker)",
  "type": "object",
  "required": [
    "schema_version",
    "projection_materialize_attempt_id",
    "project_id",
    "subject_ref",
    "subject_fingerprint",
    "projection_kind",
    "target_repository",
    "materialized_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "projection_materialize_attempt_id": {"$ref": "../common/identity.schema.json"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "subject_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"enum": ["difference", "change", "observation_evidence"]}}}
      ]
    },
    "subject_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "projection_kind": {
      "enum": ["DIFFERENCE_ISSUE", "CHANGE_PULL_REQUEST", "EVIDENCE_ARTIFACT"]
    },
    "target_repository": {
      "type": "object",
      "required": ["host", "owner", "repo"],
      "properties": {
        "host": {"const": "github"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 128},
        "repo": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "materialized_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "additionalProperties": false
}
