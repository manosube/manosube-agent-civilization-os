{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/acceptance_policy/acceptance_policy_adoption.schema.json",
  "title": "Acceptance Policy Adoption",
  "description": "The identity-bound Human Authority decision that activates a proposed transition or the baseline genesis (FD4-C3). Only the Human Authority may bind one of these; an Agent may propose (`acceptance_policy_transition`) but never adopt.",
  "type": "object",
  "required": [
    "schema_version",
    "acceptance_policy_adoption_id",
    "project_id",
    "governing_issue",
    "adopted_ref",
    "decision_owner",
    "source_reference",
    "governance_adoption_record",
    "decided_at",
    "adoption_semantic_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "acceptance_policy_adoption_id": {"type": "string", "pattern": "^AP-ADOPT-[0-9A-F]{64}(?![\\s\\S])"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "governing_issue": {"type": "integer", "minimum": 1},
    "adopted_ref": {"$ref": "#/$defs/adopted_ref"},
    "decision_owner": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"},
    "source_reference": {"$ref": "acceptance_policy_baseline.schema.json#/$defs/source_reference"},
    "governance_adoption_record": {"$ref": "#/$defs/governance_adoption_record"},
    "decided_at": {"$ref": "../common/timestamp.schema.json"},
    "adoption_semantic_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
  },
  "additionalProperties": false,
  "$defs": {
    "adopted_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["acceptance_policy_baseline", "acceptance_policy_transition"]},
        "id": {"type": "string", "pattern": "^AP-(?:BASE|TRANS)-[0-9A-F]{64}(?![\\s\\S])"}
      },
      "additionalProperties": false
    },
    "governance_adoption_record": {
      "description": "P82-R2-F1: the caller-supplied Governance Adoption Record this adoption is bound to -- evaluated at commit and every subsequent read through the existing, non-substitutable manosube_agent_civilization.development_binding.adoption_record.evaluate_adoption_record owner (Issue #53), never a second reimplementation. Wire shape mirrors that module's own REQUIRED_REQUEST_KEYS/RECEIPT_KEYS exactly; the deeper regex/semantic checks (comment URL grammar, SHA shape, receipt agreement) are that module's own responsibility, not restated here.",
      "type": "object",
      "required": [
        "schema_version",
        "adoption_id",
        "governing_issue",
        "comment_url",
        "decision_authority",
        "decision_status",
        "api_read_back_receipt",
        "reviewed_sha",
        "authorized_target_sha"
      ],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "adoption_id": {"type": "string", "minLength": 1},
        "governing_issue": {"type": "string", "minLength": 1},
        "comment_url": {"type": "string", "minLength": 1},
        "decision_authority": {"type": "string", "minLength": 1},
        "decision_status": {"type": "string", "minLength": 1},
        "api_read_back_receipt": {"$ref": "#/$defs/governance_adoption_record_receipt"},
        "reviewed_sha": {"type": "string", "minLength": 1},
        "authorized_target_sha": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "governance_adoption_record_receipt": {
      "type": "object",
      "required": [
        "adoption_id",
        "governing_issue",
        "reviewed_sha",
        "comment_url",
        "decision_authority",
        "decision_status"
      ],
      "properties": {
        "adoption_id": {"type": "string", "minLength": 1},
        "governing_issue": {"type": "string", "minLength": 1},
        "reviewed_sha": {"type": "string", "minLength": 1},
        "comment_url": {"type": "string", "minLength": 1},
        "decision_authority": {"type": "string", "minLength": 1},
        "decision_status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
