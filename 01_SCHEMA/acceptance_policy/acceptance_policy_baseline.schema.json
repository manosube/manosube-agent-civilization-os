{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/acceptance_policy/acceptance_policy_baseline.schema.json",
  "title": "Acceptance Policy Baseline",
  "description": "The immutable original acceptance-policy contract for one governing Issue/work unit (FD4-C2). Genesis record: exactly one per (project_id, governing_issue), never rewritten by a later supplement or supersession.",
  "type": "object",
  "required": ["schema_version", "acceptance_policy_baseline_id", "project_id", "governing_issue", "source_reference", "clauses", "baseline_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "acceptance_policy_baseline_id": {"type": "string", "pattern": "^AP-BASE-[0-9A-F]{64}(?![\\s\\S])"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "governing_issue": {"type": "integer", "minimum": 1},
    "source_reference": {"$ref": "#/$defs/source_reference"},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "acceptance_policy_clause.schema.json"}
    },
    "baseline_semantic_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
  },
  "additionalProperties": false,
  "$defs": {
    "source_reference": {
      "type": "object",
      "required": ["comment_url", "comment_id", "comment_author", "comment_author_association", "source_kind"],
      "properties": {
        "comment_url": {
          "type": "string",
          "pattern": "^https://github\\.com/manosube/manosube-agent-civilization-os/(?:issues|pull)/[0-9]+#issuecomment-[0-9]+(?![\\s\\S])"
        },
        "comment_id": {"type": "string", "pattern": "^[0-9]+(?![\\s\\S])"},
        "comment_author": {"type": "string", "minLength": 1, "maxLength": 128},
        "comment_author_association": {"const": "OWNER"},
        "source_kind": {"enum": ["ORIGINAL_ISSUE", "STRUCTURAL_REVIEW", "AUTHORITY_ADOPTION", "OTHER"]}
      },
      "additionalProperties": false
    }
  }
}
