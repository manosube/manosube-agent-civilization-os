{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/authority/verifier_selection_decision.schema.json",
  "title": "Verifier Selection Decision",
  "type": "object",
  "required": ["schema_version", "verifier_selection_decision_id", "project_id", "requirement_id", "selection_id", "verifier_identity", "permitted_boundary", "selection_status", "selection_authority_ref", "grant_ref", "excluding_grant_refs", "declaration_ref", "decision", "decision_reason_codes", "decision_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "verifier_selection_decision_id": {"type": "string", "pattern": "^VSEL-DEC-[0-9A-F]{64}(?![\\s\\S])"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "requirement_id": {"$ref": "../common/identity.schema.json"},
    "selection_id": {"$ref": "../common/identity.schema.json"},
    "verifier_identity": {},
    "permitted_boundary": {},
    "selection_status": {"enum": ["ACTIVE", "REVOKED", "EXPIRED"]},
    "selection_authority_ref": {"$ref": "authority.schema.json#/$defs/human_authority_ref"},
    "grant_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/grant_ref"}]},
    "excluding_grant_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/grant_ref"}},
    "declaration_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/declaration_ref"}]},
    "decision": {"enum": ["VERIFIER_SELECTION_SELECTED", "VERIFIER_SELECTION_REFUSED"]},
    "decision_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "authority.schema.json#/$defs/reason_code"}},
    "decision_semantic_fingerprint": {"$ref": "authority.schema.json#/$defs/semantic_fingerprint"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "VERIFIER_SELECTION_SELECTED"}}, "required": ["decision"]}, "then": {"properties": {"grant_ref": {"$ref": "#/$defs/grant_ref"}, "declaration_ref": {"$ref": "#/$defs/declaration_ref"}}}},
    {"if": {"properties": {"decision": {"const": "VERIFIER_SELECTION_REFUSED"}}, "required": ["decision"]}, "then": {"properties": {"grant_ref": {"const": null}, "declaration_ref": {"const": null}}}}
  ],
  "$defs": {
    "grant_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "verifier_selection_grant"}, "id": {"type": "string", "pattern": "^VSEL-GRANT-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false},
    "declaration_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "human_grant_declaration"}, "id": {"type": "string", "pattern": "^HGD-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
