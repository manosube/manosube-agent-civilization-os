{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/authority/model_execution_decision.schema.json",
  "title": "Model Execution Authorization Decision",
  "type": "object",
  "required": ["schema_version", "model_execution_decision_id", "project_id", "difference_ref", "required_capability", "boundary_ref", "selection_authority_ref", "grant_ref", "excluding_grant_refs", "decision", "decision_reason_codes", "decision_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "model_execution_decision_id": {"type": "string", "pattern": "^MODEL-EXEC-DEC-[0-9A-F]{64}(?![\\s\\S])"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "difference_ref": {"$ref": "../model_runtime/model_work_unit.schema.json#/$defs/difference_ref"},
    "required_capability": {"$ref": "../model_runtime/model_execution_boundary.schema.json#/$defs/required_capability"},
    "boundary_ref": {"$ref": "../model_runtime/model_work_unit.schema.json#/$defs/boundary_ref"},
    "selection_authority_ref": {"$ref": "authority.schema.json#/$defs/human_authority_ref"},
    "grant_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/grant_ref"}]},
    "excluding_grant_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/grant_ref"}},
    "decision": {"enum": ["MODEL_EXECUTION_AUTHORIZED", "MODEL_EXECUTION_REFUSED"]},
    "decision_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "authority.schema.json#/$defs/reason_code"}},
    "decision_semantic_fingerprint": {"$ref": "authority.schema.json#/$defs/semantic_fingerprint"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "MODEL_EXECUTION_AUTHORIZED"}}, "required": ["decision"]}, "then": {"properties": {"grant_ref": {"$ref": "#/$defs/grant_ref"}}}},
    {"if": {"properties": {"decision": {"const": "MODEL_EXECUTION_REFUSED"}}, "required": ["decision"]}, "then": {"properties": {"grant_ref": {"const": null}}}}
  ],
  "$defs": {
    "grant_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "model_execution_grant"}, "id": {"type": "string", "pattern": "^MODEL-EXEC-GRANT-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
