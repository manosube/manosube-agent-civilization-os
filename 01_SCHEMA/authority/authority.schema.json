{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/authority/authority.schema.json",
  "title": "Authority Decision",
  "type": "object",
  "required": ["schema_version", "authority_decision_id", "project_id", "difference_ref", "requested_action", "requested_scope", "evaluated_state_revision", "evaluated_state_fingerprint", "resolved_rule_ref", "prohibition_refs", "approval_ref", "excluding_approval_refs", "decision", "decision_reason_codes", "decision_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "authority_decision_id": {"type": "string", "pattern": "^AUTH-DEC-[0-9A-F]{64}$"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "difference_ref": {"$ref": "#/$defs/difference_ref"},
    "requested_action": {"$ref": "#/$defs/action"},
    "requested_scope": {"$ref": "#/$defs/scope"},
    "evaluated_state_revision": {"type": "integer", "minimum": 0},
    "evaluated_state_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "resolved_rule_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rule_ref"}]},
    "prohibition_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/prohibition_ref"}},
    "approval_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/approval_ref"}]},
    "excluding_approval_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/approval_ref"}},
    "decision": {"$ref": "#/$defs/decision"},
    "decision_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}},
    "decision_semantic_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "PROHIBITED"}}, "required": ["decision"]}, "then": {"properties": {"prohibition_refs": {"minItems": 1}}}},
    {"if": {"properties": {"decision": {"const": "AUTONOMOUS"}}, "required": ["decision"]}, "then": {"properties": {"prohibition_refs": {"maxItems": 0}, "excluding_approval_refs": {"maxItems": 0}}, "anyOf": [{"properties": {"resolved_rule_ref": {"$ref": "#/$defs/rule_ref"}}}, {"properties": {"approval_ref": {"$ref": "#/$defs/approval_ref"}}}]}}
  ],
  "$defs": {
    "decision": {"enum": ["AUTONOMOUS", "HUMAN_APPROVAL_REQUIRED", "PROHIBITED"]},
    "reversibility": {"enum": ["REVERSIBLE", "RECOVERABLE", "IRREVERSIBLE"]},
    "action_kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "semantic_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "action": {
      "type": "object",
      "required": ["action_kind", "reversibility", "operation", "action_semantic_fingerprint"],
      "properties": {
        "action_kind": {"$ref": "#/$defs/action_kind"},
        "reversibility": {"$ref": "#/$defs/reversibility"},
        "operation": {},
        "action_semantic_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["repository", "branch", "paths", "subjects"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "subjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "difference_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "difference"}, "id": {"type": "string", "pattern": "^D-[0-9A-F]{64}$"}}, "additionalProperties": false},
    "rule_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "authority_rule"}, "id": {"type": "string", "pattern": "^AUTH-RULE-[0-9A-F]{64}$"}}, "additionalProperties": false},
    "prohibition_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "prohibition"}, "id": {"type": "string", "pattern": "^PROHIBIT-[0-9A-F]{64}$"}}, "additionalProperties": false},
    "approval_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "approval"}, "id": {"type": "string", "pattern": "^APPROVAL-[0-9A-F]{64}$"}}, "additionalProperties": false},
    "human_authority_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "human_authority"}, "id": {"$ref": "../common/identity.schema.json"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
