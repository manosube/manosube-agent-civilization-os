{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/authority/github_projection_decision.schema.json",
  "title": "GitHub Projection Authorization Decision",
  "type": "object",
  "required": ["schema_version", "github_projection_decision_id", "project_id", "subject_ref", "subject_fingerprint", "projection_kind", "target_repository", "payload_fingerprint", "permitted_action", "selection_authority_ref", "grant_ref", "excluding_grant_refs", "declaration_ref", "decision", "decision_reason_codes", "decision_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "github_projection_decision_id": {"type": "string", "pattern": "^GH-PROJ-DEC-[0-9A-F]{64}(?![\\s\\S])"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "subject_ref": {"$ref": "github_projection_grant.schema.json#/properties/subject_ref"},
    "subject_fingerprint": {"type": "string", "minLength": 1},
    "projection_kind": {"enum": ["DIFFERENCE_ISSUE", "CHANGE_PULL_REQUEST", "EVIDENCE_ARTIFACT"]},
    "target_repository": {"$ref": "github_projection_grant.schema.json#/properties/target_repository"},
    "payload_fingerprint": {"type": "string", "minLength": 1},
    "permitted_action": {"const": "MATERIALIZE_PROJECTION"},
    "selection_authority_ref": {"$ref": "authority.schema.json#/$defs/human_authority_ref"},
    "grant_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/grant_ref"}]},
    "excluding_grant_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/grant_ref"}},
    "declaration_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/declaration_ref"}]},
    "decision": {"enum": ["PROJECTION_AUTHORIZED", "PROJECTION_REFUSED"]},
    "decision_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "authority.schema.json#/$defs/reason_code"}},
    "decision_semantic_fingerprint": {"$ref": "authority.schema.json#/$defs/semantic_fingerprint"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "PROJECTION_AUTHORIZED"}}, "required": ["decision"]}, "then": {"properties": {"grant_ref": {"$ref": "#/$defs/grant_ref"}, "declaration_ref": {"$ref": "#/$defs/declaration_ref"}}}},
    {"if": {"properties": {"decision": {"const": "PROJECTION_REFUSED"}}, "required": ["decision"]}, "then": {"properties": {"grant_ref": {"const": null}, "declaration_ref": {"const": null}}}}
  ],
  "$defs": {
    "grant_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "github_projection_grant"}, "id": {"type": "string", "pattern": "^GH-PROJ-GRANT-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false},
    "declaration_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "github_projection_grant_declaration"}, "id": {"type": "string", "pattern": "^GH-PROJ-DECL-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
