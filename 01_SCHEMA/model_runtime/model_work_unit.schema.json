{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/model_runtime/model_work_unit.schema.json",
  "title": "Canonical State-bound Model Work Unit",
  "type": "object",
  "required": [
    "schema_version",
    "model_work_unit_id",
    "model_work_unit_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "opened_state_revision",
    "opened_semantic_fingerprint",
    "difference_ref",
    "required_capability",
    "authority_ref",
    "boundary_ref",
    "evidence_requirements",
    "opened_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "model_work_unit_id": {
      "type": "string",
      "pattern": "^MODEL-WORK-UNIT-[0-9A-F]{64}(?![\\s\\S])"
    },
    "model_work_unit_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {"$ref": "#/$defs/project_binding_ref"},
    "opened_state_revision": {"type": "integer", "minimum": 0},
    "opened_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "difference_ref": {"$ref": "#/$defs/difference_ref"},
    "required_capability": {
      "$ref": "model_execution_boundary.schema.json#/$defs/required_capability"
    },
    "authority_ref": {"$ref": "#/$defs/authority_ref"},
    "boundary_ref": {"$ref": "#/$defs/boundary_ref"},
    "evidence_requirements": {"$ref": "#/$defs/evidence_requirements"},
    "opened_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "difference_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "difference"}}}
      ]
    },
    "authority_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_execution_decision"}}}
      ]
    },
    "boundary_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_execution_boundary"}}}
      ]
    },
    "evidence_requirements": {
      "type": "object",
      "required": [
        "evidence_position",
        "required_request_keys",
        "required_provenance_fields"
      ],
      "properties": {
        "evidence_position": {"const": "CHANGE_FREE_VERIFICATION_EVIDENCE"},
        "required_request_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required_provenance_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
