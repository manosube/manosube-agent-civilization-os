{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/model_runtime/model_execution_boundary.schema.json",
  "title": "Canonical Model Execution Boundary",
  "type": "object",
  "required": [
    "schema_version",
    "model_execution_boundary_id",
    "model_execution_boundary_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "permitted_capability",
    "permitted_candidate_kinds",
    "permitted_candidate_fields",
    "declared_by",
    "declared_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "model_execution_boundary_id": {
      "type": "string",
      "pattern": "^MODEL-EXECUTION-BOUNDARY-[0-9A-F]{64}(?![\\s\\S])"
    },
    "model_execution_boundary_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "permitted_capability": {"$ref": "#/$defs/required_capability"},
    "permitted_candidate_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["OBSERVATION_CANDIDATE"]}
    },
    "permitted_candidate_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "declared_by": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "human_authority"}}}
      ]
    },
    "declared_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "required_capability": {"enum": ["PROPOSE_EVIDENCE_CANDIDATE"]}
  },
  "additionalProperties": false
}
