{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/model_runtime/model_swap_receipt.schema.json",
  "title": "Canonical Model Swap Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "model_swap_receipt_id",
    "model_swap_receipt_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "model_work_unit_ref",
    "predecessor_execution_ref",
    "predecessor_adapter_identity",
    "predecessor_state_revision",
    "predecessor_semantic_fingerprint",
    "successor_execution_ref",
    "successor_adapter_identity",
    "successor_state_revision",
    "successor_semantic_fingerprint",
    "difference_ref",
    "required_capability",
    "authority_ref",
    "boundary_ref",
    "evidence_requirements",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "model_swap_receipt_id": {
      "type": "string",
      "pattern": "^MODEL-SWAP-[0-9A-F]{64}(?![\\s\\S])"
    },
    "model_swap_receipt_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {"$ref": "model_work_unit.schema.json#/$defs/project_binding_ref"},
    "model_work_unit_ref": {
      "$ref": "model_execution_envelope.schema.json#/$defs/model_work_unit_ref"
    },
    "predecessor_execution_ref": {"$ref": "#/$defs/model_execution_envelope_ref"},
    "predecessor_adapter_identity": {
      "$ref": "model_execution_envelope.schema.json#/$defs/adapter_identity"
    },
    "predecessor_state_revision": {"type": "integer", "minimum": 0},
    "predecessor_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "successor_execution_ref": {"$ref": "#/$defs/model_execution_envelope_ref"},
    "successor_adapter_identity": {
      "$ref": "model_execution_envelope.schema.json#/$defs/adapter_identity"
    },
    "successor_state_revision": {"type": "integer", "minimum": 0},
    "successor_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "difference_ref": {"$ref": "model_work_unit.schema.json#/$defs/difference_ref"},
    "required_capability": {
      "$ref": "model_execution_boundary.schema.json#/$defs/required_capability"
    },
    "authority_ref": {"$ref": "model_work_unit.schema.json#/$defs/authority_ref"},
    "boundary_ref": {"$ref": "model_work_unit.schema.json#/$defs/boundary_ref"},
    "evidence_requirements": {
      "$ref": "model_work_unit.schema.json#/$defs/evidence_requirements"
    },
    "recorded_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "model_execution_envelope_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_execution_envelope"}}}
      ]
    }
  },
  "additionalProperties": false
}
