{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/model_runtime/session_recovery_receipt.schema.json",
  "title": "Canonical Model Execution Session Recovery Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "session_recovery_receipt_id",
    "session_recovery_receipt_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "model_work_unit_ref",
    "recovered_state_revision",
    "recovered_semantic_fingerprint",
    "difference_ref",
    "required_capability",
    "authority_ref",
    "boundary_ref",
    "evidence_requirements",
    "recovered_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "session_recovery_receipt_id": {
      "type": "string",
      "pattern": "^MODEL-SESSION-RECOVERY-[0-9A-F]{64}(?![\\s\\S])"
    },
    "session_recovery_receipt_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {"$ref": "model_work_unit.schema.json#/$defs/project_binding_ref"},
    "model_work_unit_ref": {
      "$ref": "model_execution_envelope.schema.json#/$defs/model_work_unit_ref"
    },
    "recovered_state_revision": {"type": "integer", "minimum": 0},
    "recovered_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "difference_ref": {"$ref": "model_work_unit.schema.json#/$defs/difference_ref"},
    "required_capability": {
      "$ref": "model_execution_boundary.schema.json#/$defs/required_capability"
    },
    "authority_ref": {"$ref": "model_work_unit.schema.json#/$defs/authority_ref"},
    "boundary_ref": {"$ref": "model_work_unit.schema.json#/$defs/boundary_ref"},
    "evidence_requirements": {
      "$ref": "model_work_unit.schema.json#/$defs/evidence_requirements"
    },
    "recovered_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "additionalProperties": false
}
