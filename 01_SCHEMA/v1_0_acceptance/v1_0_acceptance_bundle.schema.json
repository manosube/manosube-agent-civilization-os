{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/v1_0_acceptance/v1_0_acceptance_bundle.schema.json",
  "title": "Phase 22 v1.0 Acceptance bundle (Issue #92, ADOPT_PHASE_22_V1_0_ACCEPTANCE)",
  "type": "object",
  "required": [
    "schema_version",
    "acceptance_bundle_id",
    "acceptance_bundle_semantic_fingerprint",
    "repository_project",
    "authorized_base_main_sha",
    "delivery_head",
    "gate_22_predicate_matrix",
    "gate_22_all_pass",
    "v1_0_blocking_difference_disposition",
    "negative_control_results",
    "release_identity",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "acceptance_bundle_id": {"$ref": "#/$defs/sha256hex"},
    "acceptance_bundle_semantic_fingerprint": {"$ref": "#/$defs/sha256hex"},
    "repository_project": {"const": "manosube/manosube-agent-civilization-os"},
    "authorized_base_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "delivery_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate_22_predicate_matrix": {
      "type": "object",
      "required": [
        "OBJECTIVE_CONTINUITY_PROVEN",
        "AGENT_REPLACEMENT_SAFE",
        "SESSION_LOSS_SAFE",
        "GITHUB_INDEPENDENCE",
        "RUNTIME_VERIFICATION",
        "AUTHORITY_ENFORCEMENT",
        "EVIDENCE_ONLY_COMPLETION",
        "STATE_LINEAGE_PRESERVATION",
        "LONG_RUNNING_PROOF_PASS",
        "COMPARATIVE_BENCHMARK_PASS",
        "THIRD_PARTY_REPRODUCTION_CONFIRMED",
        "ALL_V1_0_BLOCKING_DIFFERENCES_CLOSED"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Z0-9_]+$": {
          "type": "object",
          "required": ["owner_source", "evidence_identifier", "verification_result"],
          "properties": {
            "owner_source": {"enum": ["test_module", "deferred_differences_register"]},
            "evidence_identifier": {"type": "string", "minLength": 1},
            "verification_result": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
            "exit_code": {"type": ["integer", "null"]},
            "failure_category": {"type": ["string", "null"]},
            "disposition_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      }
    },
    "gate_22_all_pass": {"type": "boolean"},
    "v1_0_blocking_difference_disposition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "classification",
          "current_status",
          "current_phase_blocking_effect",
          "disposition",
          "rationale"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "current_status": {"type": "string", "minLength": 1},
          "current_phase_blocking_effect": {"type": ["string", "null"]},
          "disposition": {
            "enum": ["NON_BLOCKING", "REQUIRES_HUMAN_AUTHORITY_DISPOSITION", "REGISTER_CONTENT_CONTRADICTION"]
          },
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "negative_control_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "description", "expected_fail_closed", "observed_result"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "expected_fail_closed": {"type": "boolean"},
          "observed_result": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "release_identity": {
      "type": "object",
      "required": [
        "commit_sha",
        "tree_entry_count",
        "blob_count",
        "directory_count",
        "version_label",
        "tag_created",
        "release_published"
      ],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_entry_count": {"type": "integer", "minimum": 0},
        "blob_count": {"type": "integer", "minimum": 0},
        "directory_count": {"type": "integer", "minimum": 0},
        "version_label": {"type": "string", "minLength": 1},
        "tag_created": {"const": false},
        "release_published": {"const": false}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
