{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/difference/candidate_completion_record.schema.json",
  "title": "Candidate Completion Record", "type": "object",
  "required": ["schema_version", "completion_id", "subject_type", "subject_ref", "claim", "target_state_ref", "observed_state_ref", "closure_policy_ref", "required_evidence_refs", "invariant_evaluation_refs", "material_contradiction_refs", "evaluation_status", "evaluated_state_revision", "evaluated_state_fingerprint", "evaluated_at", "reflow_transition_ref"],
  "properties": {
    "schema_version": {"const": "0.1"}, "completion_id": {"type": "string", "pattern": "^CMP-[0-9A-F]{64}$"}, "subject_type": {"const": "DIFFERENCE"},
    "subject_ref": {"$ref": "../common/reference.schema.json"}, "claim": {}, "target_state_ref": {"oneOf": [{"type": "null"}, {"$ref": "../common/reference.schema.json"}]},
    "observed_state_ref": {"$ref": "../common/reference.schema.json"}, "closure_policy_ref": {"$ref": "difference.schema.json#/$defs/versioned_reference"},
    "required_evidence_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"}, "invariant_evaluation_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"},
    "material_contradiction_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"}, "evaluation_status": {"enum": ["SATISFIED", "NOT_SATISFIED", "UNKNOWN", "STALE", "REVOKED"]},
    "evaluated_state_revision": {"type": "integer", "minimum": 0}, "evaluated_state_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "evaluated_at": {"$ref": "../common/timestamp.schema.json"}, "reflow_transition_ref": {"type": "null"}
  }, "additionalProperties": false
}
