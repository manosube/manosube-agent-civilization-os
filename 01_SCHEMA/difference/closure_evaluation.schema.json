{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/difference/closure_evaluation.schema.json",
  "title": "Difference Closure Evaluation",
  "type": "object",
  "required": ["schema_version", "closure_evaluation_id", "difference_id", "evaluation_mode", "terminal_reason_evidence_refs", "base_kernel_source_ref_evaluated", "kernel_source_ref_evaluated", "difference_event_head_ref", "target_predicate_ref", "objective_revision_ref_evaluated", "objective_semantic_fingerprint_evaluated", "before_state_ref", "resolution_mode", "change_refs", "after_state_candidate", "after_observation_refs", "change_result_evidence_refs", "change_free_verification_evidence_refs", "verification_independence_ref", "evidence_sufficiency_ref", "candidate_invariant_evaluation_bindings", "candidate_claim_evaluation_bindings", "contradiction_refs", "evaluated_state_revision", "evaluated_state_fingerprint", "evaluated_at", "evaluation_expires_at", "policy_ref", "policy_version_evaluated", "policy_semantic_fingerprint_evaluated", "proposed_terminal_status", "gate_results", "result", "failure_reasons", "reflow_transition_ref"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "closure_evaluation_id": {"type": "string", "pattern": "^D-CLOSE-EVAL-[0-9A-F]{64}$"},
    "difference_id": {"type": "string", "pattern": "^D-[0-9A-F]{64}$"},
    "evaluation_mode": {"enum": ["CANDIDATE_CLOSURE", "CANDIDATE_TERMINAL", "TERMINAL_POLICY_ONLY"]},
    "base_kernel_source_ref_evaluated": {"$ref": "#/$defs/git_tree_ref"},
    "kernel_source_ref_evaluated": {"$ref": "#/$defs/git_tree_ref"},
    "difference_event_head_ref": {"$ref": "../common/reference.schema.json"},
    "target_predicate_ref": {"$ref": "../common/reference.schema.json"},
    "objective_revision_ref_evaluated": {"$ref": "../common/reference.schema.json"},
    "objective_semantic_fingerprint_evaluated": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"},
    "before_state_ref": {"$ref": "#/$defs/state_ref"},
    "resolution_mode": {"oneOf": [{"type": "null"}, {"enum": ["CHANGE_BOUND", "CHANGE_FREE"]}]},
    "change_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}},
    "policy_ref": {"$ref": "difference.schema.json#/$defs/versioned_reference"},
    "evaluated_state_revision": {"type": "integer", "minimum": 0},
    "evaluated_state_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "after_state_candidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/after_state_candidate"}]},
    "after_observation_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}},
    "change_result_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}},
    "change_free_verification_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}},
    "verification_independence_ref": {"type": "null"},
    "evidence_sufficiency_ref": {"oneOf": [{"type": "null"}, {"$ref": "../common/reference.schema.json"}]},
    "terminal_reason_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}},
    "candidate_invariant_evaluation_bindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidate_invariant_binding"}},
    "candidate_claim_evaluation_bindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidate_claim_binding"}},
    "contradiction_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/reference.schema.json"}},
    "proposed_terminal_status": {"enum": ["CLOSED", "BLOCKED", "RETAINED"]},
    "gate_results": {"$ref": "#/$defs/gates"},
    "result": {"enum": ["NOT_EVALUATED", "EVALUATING", "SATISFIED", "NOT_SATISFIED", "BLOCKED", "STALE", "CONTRADICTED", "REVOKED"]},
    "evaluated_at": {"$ref": "../common/timestamp.schema.json"},
    "evaluation_expires_at": {"oneOf": [{"type": "null"}, {"$ref": "../common/timestamp.schema.json"}]},
    "policy_version_evaluated": {"const": "0.1"},
    "policy_semantic_fingerprint_evaluated": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"},
    "failure_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reflow_transition_ref": {"oneOf": [{"type": "null"}, {"$ref": "../common/reference.schema.json"}]}
  },
  "$defs": {
    "git_tree_ref": {
      "type": "object", "required": ["kind", "repository", "commit_sha", "tree_sha"],
      "properties": {"kind": {"const": "git_tree"}, "repository": {"const": "manosube/manosube-agent-civilization-os"}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}, "additionalProperties": false
    },
    "state_ref": {
      "type": "object", "required": ["kind", "revision", "fingerprint"],
      "properties": {"kind": {"const": "state"}, "revision": {"type": "integer", "minimum": 0}, "fingerprint": {"$ref": "../common/fingerprint.schema.json"}}, "additionalProperties": false
    },
    "after_state_candidate": {
      "type": "object", "required": ["kind", "candidate_id", "kernel_source_ref", "base_state_ref", "semantic_state", "semantic_fingerprint", "source_snapshot_refs", "producing_change_refs"],
      "properties": {"kind": {"const": "after_state_candidate"}, "candidate_id": {"type": "string", "pattern": "^STATE-CANDIDATE-[0-9A-F]{64}$"}, "kernel_source_ref": {"$ref": "#/$defs/git_tree_ref"}, "base_state_ref": {"$ref": "#/$defs/state_ref"}, "semantic_state": {"$ref": "../state/semantic_state.schema.json"}, "semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"}, "source_snapshot_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"}, "producing_change_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"}}, "additionalProperties": false
    },
    "candidate_invariant_binding": {
      "type": "object", "required": ["kind", "binding_id", "candidate_id", "candidate_semantic_fingerprint", "base_state_ref", "invariant_ref", "invariant_definition_ref", "invariant_evaluation_ref", "evaluation_record_fingerprint", "evaluation_result", "evaluation_evidence_refs", "evaluated_at"],
      "properties": {"kind": {"const": "candidate_invariant_evaluation_binding"}, "binding_id": {"type": "string", "pattern": "^CAND-INV-EVAL-[0-9A-F]{64}$"}, "candidate_id": {"type": "string", "pattern": "^STATE-CANDIDATE-[0-9A-F]{64}$"}, "candidate_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"}, "base_state_ref": {"$ref": "#/$defs/state_ref"}, "invariant_ref": {"$ref": "../common/reference.schema.json"}, "invariant_definition_ref": {"type": "object", "required": ["repository", "path", "invariant_definition_sha256"], "properties": {"repository": {"const": "manosube/manosube-agent-civilization-os"}, "path": {"const": "00_KERNEL/KERNEL_INVARIANTS.md"}, "invariant_definition_sha256": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}}, "additionalProperties": false}, "invariant_evaluation_ref": {"$ref": "../common/reference.schema.json"}, "evaluation_record_fingerprint": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}, "evaluation_result": {"enum": ["PASS", "FAIL", "UNKNOWN", "STALE", "REVOKED"]}, "evaluation_evidence_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"}, "evaluated_at": {"$ref": "../common/timestamp.schema.json"}}, "additionalProperties": false
    },
    "candidate_claim_binding": {
      "type": "object", "required": ["kind", "binding_id", "difference_id", "policy_ref", "candidate_id", "candidate_semantic_fingerprint", "base_state_ref", "required_claim_ref", "evaluation_series_id", "evaluation_head_event_ref", "completion_record_ref", "evaluation_record_fingerprint", "evaluation_status", "evaluation_evidence_refs", "evaluated_at"],
      "properties": {"kind": {"const": "candidate_claim_evaluation_binding"}, "binding_id": {"type": "string", "pattern": "^CAND-CLAIM-EVAL-[0-9A-F]{64}$"}, "difference_id": {"type": "string", "pattern": "^D-[0-9A-F]{64}$"}, "policy_ref": {"$ref": "difference.schema.json#/$defs/versioned_reference"}, "candidate_id": {"type": "string", "pattern": "^STATE-CANDIDATE-[0-9A-F]{64}$"}, "candidate_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"}, "base_state_ref": {"$ref": "#/$defs/state_ref"}, "required_claim_ref": {"$ref": "../common/reference.schema.json"}, "evaluation_series_id": {"type": "string", "pattern": "^CAND-CLAIM-SERIES-[0-9A-F]{64}$"}, "evaluation_head_event_ref": {"$ref": "../common/reference.schema.json"}, "completion_record_ref": {"$ref": "../common/reference.schema.json"}, "evaluation_record_fingerprint": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}, "evaluation_status": {"const": "SATISFIED"}, "evaluation_evidence_refs": {"$ref": "difference.schema.json#/$defs/unordered_references"}, "evaluated_at": {"$ref": "../common/timestamp.schema.json"}}, "additionalProperties": false
    },
    "gate_value": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
    "gates": {
      "type": "object",
      "required": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9", "G10", "G11", "G12", "G13", "G14", "G15", "G16", "G17", "G18", "G19", "G20", "G21", "G22"],
      "properties": {"G1": {"$ref": "#/$defs/gate_value"}, "G2": {"$ref": "#/$defs/gate_value"}, "G3": {"$ref": "#/$defs/gate_value"}, "G4": {"$ref": "#/$defs/gate_value"}, "G5": {"$ref": "#/$defs/gate_value"}, "G6": {"$ref": "#/$defs/gate_value"}, "G7": {"$ref": "#/$defs/gate_value"}, "G8": {"$ref": "#/$defs/gate_value"}, "G9": {"$ref": "#/$defs/gate_value"}, "G10": {"$ref": "#/$defs/gate_value"}, "G11": {"$ref": "#/$defs/gate_value"}, "G12": {"$ref": "#/$defs/gate_value"}, "G13": {"$ref": "#/$defs/gate_value"}, "G14": {"$ref": "#/$defs/gate_value"}, "G15": {"$ref": "#/$defs/gate_value"}, "G16": {"$ref": "#/$defs/gate_value"}, "G17": {"$ref": "#/$defs/gate_value"}, "G18": {"$ref": "#/$defs/gate_value"}, "G19": {"$ref": "#/$defs/gate_value"}, "G20": {"$ref": "#/$defs/gate_value"}, "G21": {"$ref": "#/$defs/gate_value"}, "G22": {"$ref": "#/$defs/gate_value"}}, "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"evaluation_mode": {"const": "CANDIDATE_CLOSURE"}}, "required": ["evaluation_mode"]}, "then": {"properties": {"after_state_candidate": {"not": {"type": "null"}}, "resolution_mode": {"not": {"type": "null"}}, "after_observation_refs": {"minItems": 1}, "evidence_sufficiency_ref": {"not": {"type": "null"}}, "proposed_terminal_status": {"const": "CLOSED"}, "result": {"const": "SATISFIED"}, "gate_results": {"properties": {"G22": {"const": "PASS"}}}}}},
    {"if": {"properties": {"evaluation_mode": {"const": "CANDIDATE_TERMINAL"}}, "required": ["evaluation_mode"]}, "then": {"properties": {"after_state_candidate": {"not": {"type": "null"}}, "terminal_reason_evidence_refs": {"minItems": 1}, "proposed_terminal_status": {"enum": ["BLOCKED", "RETAINED"]}, "result": {"enum": ["BLOCKED", "STALE", "CONTRADICTED", "NOT_SATISFIED"]}}}},
    {"if": {"properties": {"evaluation_mode": {"const": "TERMINAL_POLICY_ONLY"}}, "required": ["evaluation_mode"]}, "then": {"properties": {"after_state_candidate": {"type": "null"}, "resolution_mode": {"type": "null"}, "change_refs": {"maxItems": 0}, "after_observation_refs": {"maxItems": 0}, "change_result_evidence_refs": {"maxItems": 0}, "change_free_verification_evidence_refs": {"maxItems": 0}, "terminal_reason_evidence_refs": {"minItems": 1}, "candidate_invariant_evaluation_bindings": {"maxItems": 0}, "candidate_claim_evaluation_bindings": {"maxItems": 0}, "proposed_terminal_status": {"enum": ["BLOCKED", "RETAINED"]}, "result": {"const": "BLOCKED"}, "gate_results": {"properties": {"G22": {"const": "PASS"}}}}}},
    {"if": {"properties": {"resolution_mode": {"const": "CHANGE_BOUND"}}, "required": ["resolution_mode"]}, "then": {"properties": {"change_refs": {"minItems": 1}, "change_result_evidence_refs": {"minItems": 1}, "change_free_verification_evidence_refs": {"maxItems": 0}}}},
    {"if": {"properties": {"resolution_mode": {"const": "CHANGE_FREE"}}, "required": ["resolution_mode"]}, "then": {"properties": {"change_refs": {"maxItems": 0}, "change_result_evidence_refs": {"maxItems": 0}, "change_free_verification_evidence_refs": {"minItems": 1}}}}
  ],
  "additionalProperties": false
}
