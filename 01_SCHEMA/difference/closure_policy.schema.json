{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/difference/closure_policy.schema.json",
  "title": "Difference Closure Policy",
  "type": "object",
  "required": ["schema_version", "closure_policy_id", "policy_version", "policy_semantic_fingerprint", "subject_difference_ref", "target_predicate_ref", "required_observation_scope", "minimum_evidence_level", "required_claims", "required_invariants", "allowed_terminal_states", "independent_verification_required", "maximum_evidence_age", "contradiction_policy", "reopen_conditions"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "closure_policy_id": {"type": "string", "pattern": "^CP-[0-9A-F]{64}$"},
    "policy_version": {"const": "0.1"},
    "policy_semantic_fingerprint": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"},
    "subject_difference_ref": {"$ref": "../common/reference.schema.json"},
    "target_predicate_ref": {"$ref": "../common/reference.schema.json"},
    "required_observation_scope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resolved_scope_ref"}]},
    "minimum_evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]},
    "required_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/completion_claim"}},
    "required_invariants": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/invariant_requirement"}},
    "allowed_terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CLOSED", "BLOCKED", "RETAINED"]}},
    "independent_verification_required": {"const": false},
    "maximum_evidence_age": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
    "contradiction_policy": {"const": "FAIL_CLOSED"},
    "reopen_conditions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reopen_condition"}}
  },
  "$defs": {
    "resolved_scope_ref": {
      "type": "object", "required": ["kind", "id", "schema_version", "resolved_record_sha256"],
      "properties": {"kind": {"const": "observation_scope"}, "id": {"$ref": "../common/identity.schema.json"}, "schema_version": {"const": "0.1"}, "resolved_record_sha256": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}}, "additionalProperties": false
    },
    "reopen_condition": {
      "type": "object", "required": ["kind", "id", "objective_revision_ref", "predicate_semantic_fingerprint"],
      "properties": {"kind": {"const": "target_predicate"}, "id": {"$ref": "../common/identity.schema.json"}, "objective_revision_ref": {"$ref": "../common/reference.schema.json"}, "predicate_semantic_fingerprint": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}}, "additionalProperties": false
    },
    "completion_claim": {
      "type": "object", "required": ["kind", "id", "subject_type", "subject_ref", "claim", "target_state_ref", "claim_semantic_fingerprint"],
      "properties": {"kind": {"const": "completion_claim"}, "id": {"type": "string", "pattern": "^CLAIM-[0-9A-F]{64}$"}, "subject_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "subject_ref": {"$ref": "../common/reference.schema.json"}, "claim": {"type": "object"}, "target_state_ref": {"oneOf": [{"type": "null"}, {"$ref": "../common/reference.schema.json"}]}, "claim_semantic_fingerprint": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}}, "additionalProperties": false
    },
    "invariant_requirement": {
      "type": "object", "required": ["kind", "id", "contract_source_ref"],
      "properties": {"kind": {"const": "kernel_invariant"}, "id": {"type": "string", "pattern": "^[A-Z]-[0-9]{3}$"}, "contract_source_ref": {"type": "object", "required": ["kind", "repository", "commit_sha", "path", "blob_sha", "invariant_definition_sha256"], "properties": {"kind": {"const": "git_blob"}, "repository": {"const": "manosube/manosube-agent-civilization-os"}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"const": "00_KERNEL/KERNEL_INVARIANTS.md"}, "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "invariant_definition_sha256": {"$ref": "difference.schema.json#/$defs/semantic_fingerprint"}}, "additionalProperties": false}}, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
