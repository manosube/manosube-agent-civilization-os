{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/work_time_transparency/work_time_coordination_update.schema.json",
  "title": "Human Wait-Time Transparency: Work Coordination Update (heartbeat / re-estimate / external wait / blocker)",
  "type": "object",
  "required": [
    "schema_version",
    "work_time_coordination_update_id",
    "work_time_coordination_update_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "open_ref",
    "predecessor_ref",
    "sequence_number",
    "position_kind",
    "current_position",
    "material_result_or_blocker",
    "is_material_reestimate",
    "remaining_duration_unknown",
    "revised_remaining_duration_lower_minutes",
    "revised_remaining_duration_upper_minutes",
    "human_action_required",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "work_time_coordination_update_id": {"$ref": "#/$defs/update_id"},
    "work_time_coordination_update_semantic_fingerprint": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "open_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "work_time_coordination_open"}}}
      ]
    },
    "predecessor_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"enum": [
          "work_time_coordination_open",
          "work_time_coordination_update"
        ]}}}
      ]
    },
    "sequence_number": {"type": "integer", "minimum": 1},
    "position_kind": {"enum": ["WORK_RUNNING", "EXTERNAL_REVIEW_WAIT", "BLOCKED", "ERROR"]},
    "current_position": {"type": "string", "minLength": 1, "maxLength": 2048},
    "material_result_or_blocker": {"type": "string", "maxLength": 4096},
    "is_material_reestimate": {"type": "boolean"},
    "remaining_duration_unknown": {"type": "boolean"},
    "revised_remaining_duration_lower_minutes": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
    },
    "revised_remaining_duration_upper_minutes": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
    },
    "human_action_required": {"type": "boolean"},
    "recorded_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "update_id": {"type": "string", "pattern": "^WTC-UPDATE-[0-9A-F]{64}(?![\\s\\S])"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
  },
  "additionalProperties": false
}
