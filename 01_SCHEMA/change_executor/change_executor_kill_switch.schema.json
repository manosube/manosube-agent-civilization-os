{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/change_executor/change_executor_kill_switch.schema.json",
  "title": "Change Executor Kill Switch",
  "type": "object",
  "required": ["schema_version", "change_executor_kill_switch_id", "project_id", "status", "generation", "predecessor_ref", "signature", "change_executor_kill_switch_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "change_executor_kill_switch_id": {"$ref": "#/$defs/kill_switch_id"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "status": {"enum": ["ACTIVE", "REVOKED"]},
    "generation": {"type": "integer", "minimum": 0},
    "predecessor_ref": {"$ref": "#/$defs/predecessor_ref"},
    "signature": {"$ref": "#/$defs/signature"},
    "change_executor_kill_switch_semantic_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
  },
  "$defs": {
    "kill_switch_id": {"type": "string", "pattern": "^EXEC-KILLSWITCH-[0-9A-F]{64}(?![\\s\\S])"},
    "predecessor_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "allOf": [
            {"$ref": "../common/reference.schema.json"},
            {"properties": {"kind": {"const": "change_executor_kill_switch"}, "id": {"$ref": "#/$defs/kill_switch_id"}}}
          ]
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"$ref": "../common/identity.schema.json"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{128}(?![\\s\\S])"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
