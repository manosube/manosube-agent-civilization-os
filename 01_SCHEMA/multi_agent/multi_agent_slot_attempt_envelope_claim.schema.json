{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/multi_agent/multi_agent_slot_attempt_envelope_claim.schema.json",
  "title": "Canonical Multi-Agent Slot Attempt Envelope Claim",
  "type": "object",
  "required": [
    "schema_version",
    "multi_agent_slot_attempt_envelope_claim_id",
    "multi_agent_slot_attempt_envelope_claim_semantic_fingerprint",
    "project_id",
    "plan_ref",
    "slot_index",
    "attempt_ordinal",
    "model_execution_envelope_ref"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "multi_agent_slot_attempt_envelope_claim_id": {
      "type": "string",
      "pattern": "^MULTI-AGENT-ENVELOPE-CLAIM-[0-9A-F]{64}(?![\\s\\S])"
    },
    "multi_agent_slot_attempt_envelope_claim_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "plan_ref": {"$ref": "#/$defs/plan_ref"},
    "slot_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "attempt_ordinal": {"type": "integer", "minimum": 1},
    "model_execution_envelope_ref": {"$ref": "#/$defs/envelope_ref"}
  },
  "$defs": {
    "plan_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_dynamic_execution_plan"}}}
      ]
    },
    "envelope_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_execution_envelope"}}}
      ]
    }
  },
  "additionalProperties": false
}
