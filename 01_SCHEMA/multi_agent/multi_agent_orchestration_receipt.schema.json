{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/multi_agent/multi_agent_orchestration_receipt.schema.json",
  "title": "Canonical Multi-Agent Orchestration Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "multi_agent_orchestration_receipt_id",
    "multi_agent_orchestration_receipt_semantic_fingerprint",
    "project_id",
    "plan_ref",
    "slot_output_refs",
    "release_receipt_refs",
    "conflict_set_ref",
    "aggregation_input_ref",
    "evidence_refs",
    "orchestration_outcome",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "multi_agent_orchestration_receipt_id": {
      "type": "string",
      "pattern": "^MULTI-AGENT-ORCHESTRATION-[0-9A-F]{64}(?![\\s\\S])"
    },
    "multi_agent_orchestration_receipt_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "plan_ref": {"$ref": "#/$defs/plan_ref"},
    "slot_output_refs": {"$ref": "#/$defs/unordered_slot_output_refs"},
    "release_receipt_refs": {"$ref": "#/$defs/unordered_release_receipt_refs"},
    "conflict_set_ref": {"$ref": "#/$defs/conflict_set_ref"},
    "aggregation_input_ref": {"$ref": "#/$defs/aggregation_input_ref"},
    "evidence_refs": {"$ref": "#/$defs/unordered_evidence_refs"},
    "orchestration_outcome": {
      "enum": ["COMPLETED_ALL_RELEASED", "COMPLETED_WITH_UNRESOLVED_CAPABILITY", "ABORTED_RELEASE_INCOMPLETE"]
    },
    "completed_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "plan_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_dynamic_execution_plan"}}}
      ]
    },
    "conflict_set_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_conflict_set"}}}
      ]
    },
    "aggregation_input_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_evidence_aggregation_input"}}}
      ]
    },
    "slot_output_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_slot_output"}}}
      ]
    },
    "unordered_slot_output_refs": {
      "type": "object",
      "required": ["collection_kind", "members"],
      "properties": {
        "collection_kind": {"const": "UNORDERED_SET"},
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slot_output_ref"}
        }
      },
      "additionalProperties": false
    },
    "release_receipt_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_agent_release_receipt"}}}
      ]
    },
    "unordered_release_receipt_refs": {
      "type": "object",
      "required": ["collection_kind", "members"],
      "properties": {
        "collection_kind": {"const": "UNORDERED_SET"},
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/release_receipt_ref"}
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "observation_evidence"}}}
      ]
    },
    "unordered_evidence_refs": {
      "type": "object",
      "required": ["collection_kind", "members"],
      "properties": {
        "collection_kind": {"const": "UNORDERED_SET"},
        "members": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
