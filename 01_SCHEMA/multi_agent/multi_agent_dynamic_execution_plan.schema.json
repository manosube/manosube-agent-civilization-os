{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/multi_agent/multi_agent_dynamic_execution_plan.schema.json",
  "title": "Canonical Multi-Agent Dynamic Execution Plan",
  "type": "object",
  "required": [
    "schema_version",
    "multi_agent_dynamic_execution_plan_id",
    "multi_agent_dynamic_execution_plan_semantic_fingerprint",
    "project_id",
    "project_binding_ref",
    "boot_state_revision",
    "boot_semantic_fingerprint",
    "difference_ref",
    "capability_selection_fingerprint",
    "slots",
    "model_work_unit_ref",
    "authority_ref",
    "adapter_identity",
    "execution_order",
    "execution_bounds",
    "conflict_policy",
    "release_policy",
    "opened_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "multi_agent_dynamic_execution_plan_id": {
      "type": "string",
      "pattern": "^MULTI-AGENT-PLAN-[0-9A-F]{64}(?![\\s\\S])"
    },
    "multi_agent_dynamic_execution_plan_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "project_binding_ref": {"$ref": "#/$defs/project_binding_ref"},
    "boot_state_revision": {"type": "integer", "minimum": 0},
    "boot_semantic_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "difference_ref": {"$ref": "#/$defs/difference_ref"},
    "capability_selection_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slot"}
    },
    "model_work_unit_ref": {"$ref": "#/$defs/model_work_unit_ref"},
    "authority_ref": {"$ref": "#/$defs/authority_ref"},
    "adapter_identity": {"$ref": "#/$defs/adapter_identity"},
    "execution_order": {"enum": ["CONCURRENT"]},
    "execution_bounds": {"$ref": "#/$defs/execution_bounds"},
    "conflict_policy": {"enum": ["EXACT_FINGERPRINT_EQUALITY_OR_EXPLICIT_DISAGREEMENT"]},
    "release_policy": {"enum": ["RELEASE_ON_TERMINAL_OUTCOME"]},
    "opened_at": {"$ref": "../common/timestamp.schema.json"},
    "expires_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "$defs": {
    "project_binding_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "project_binding"}}}
      ]
    },
    "difference_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "difference"}}}
      ]
    },
    "model_work_unit_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_work_unit"}}}
      ]
    },
    "authority_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_execution_decision"}}}
      ]
    },
    "required_capability": {"enum": ["PROPOSE_EVIDENCE_CANDIDATE"]},
    "slot": {
      "type": "object",
      "required": ["slot_index", "capability"],
      "properties": {
        "slot_index": {"type": "integer", "minimum": 0, "maximum": 2},
        "capability": {"$ref": "#/$defs/required_capability"}
      },
      "additionalProperties": false
    },
    "adapter_identity": {
      "type": "object",
      "required": ["adapter", "version"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "execution_bounds": {
      "type": "object",
      "required": [
        "deadline_at",
        "cancellation_policy",
        "max_concurrent_slots",
        "per_slot_timeout_seconds"
      ],
      "properties": {
        "deadline_at": {"$ref": "../common/timestamp.schema.json"},
        "cancellation_policy": {"enum": ["COOPERATIVE_PER_SLOT_TIMEOUT"]},
        "max_concurrent_slots": {"type": "integer", "minimum": 1, "maximum": 3},
        "per_slot_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
