{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/multi_agent/multi_agent_slot_output.schema.json",
  "title": "Canonical Multi-Agent Slot Output",
  "type": "object",
  "required": [
    "schema_version",
    "multi_agent_slot_output_id",
    "multi_agent_slot_output_semantic_fingerprint",
    "project_id",
    "plan_ref",
    "slot_index",
    "capability",
    "attempt_id",
    "attempt_ordinal",
    "model_execution_envelope_ref",
    "outcome",
    "result_fingerprint",
    "outcome_detail",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "multi_agent_slot_output_id": {
      "type": "string",
      "pattern": "^MULTI-AGENT-SLOT-OUTPUT-[0-9A-F]{64}(?![\\s\\S])"
    },
    "multi_agent_slot_output_semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "project_id": {"$ref": "../common/identity.schema.json"},
    "plan_ref": {"$ref": "#/$defs/plan_ref"},
    "slot_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "capability": {"enum": ["PROPOSE_EVIDENCE_CANDIDATE"]},
    "attempt_id": {"type": "string", "pattern": "^MULTI-AGENT-ATTEMPT-[0-9A-F]{64}(?![\\s\\S])"},
    "attempt_ordinal": {"const": 1},
    "model_execution_envelope_ref": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_execution_envelope_ref"}]
    },
    "outcome": {
      "enum": [
        "CANDIDATE_ACCEPTED",
        "UNAVAILABLE",
        "REFUSED",
        "MALFORMED",
        "TIMEOUT",
        "CANCELLED",
        "INCOMPLETE_EVIDENCE"
      ]
    },
    "result_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"}
      ]
    },
    "outcome_detail": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 2000}]},
    "started_at": {"$ref": "../common/timestamp.schema.json"},
    "ended_at": {"$ref": "../common/timestamp.schema.json"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "CANDIDATE_ACCEPTED"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "result_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
          "model_execution_envelope_ref": {"$ref": "#/$defs/model_execution_envelope_ref"}
        }
      },
      "else": {
        "properties": {"result_fingerprint": {"const": null}}
      }
    }
  ],
  "$defs": {
    "plan_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "multi_agent_dynamic_execution_plan"}}}
      ]
    },
    "model_execution_envelope_ref": {
      "allOf": [
        {"$ref": "../common/reference.schema.json"},
        {"properties": {"kind": {"const": "model_execution_envelope"}}}
      ]
    }
  },
  "additionalProperties": false
}
