{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manosube.org/agent-civilization-os/v0.1/change/change.schema.json",
  "title": "Change",
  "type": "object",
  "required": ["schema_version", "change_id", "project_id", "difference_ref", "authority_ref", "before_state_fingerprint", "expected_state_revision", "action", "scope", "idempotency_key", "execution_result", "status", "change_semantic_fingerprint"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "change_id": {"type": "string", "pattern": "^CHANGE-[0-9A-F]{64}(?![\\s\\S])"},
    "project_id": {"$ref": "../common/identity.schema.json"},
    "difference_ref": {"$ref": "#/$defs/difference_ref"},
    "authority_ref": {"$ref": "#/$defs/authority_ref"},
    "before_state_fingerprint": {"$ref": "../common/fingerprint.schema.json"},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "action": {"$ref": "../authority/authority.schema.json#/$defs/action"},
    "scope": {"$ref": "../authority/authority.schema.json#/$defs/scope"},
    "idempotency_key": {"$ref": "#/$defs/semantic_fingerprint"},
    "execution_result": {"type": "null"},
    "status": {"$ref": "#/$defs/status"},
    "change_semantic_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"}
  },
  "$defs": {
    "semantic_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
    "status": {"enum": ["AUTHORIZED"]},
    "difference_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "difference"}, "id": {"type": "string", "pattern": "^D-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false},
    "authority_ref": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "authority_decision"}, "id": {"type": "string", "pattern": "^AUTH-DEC-[0-9A-F]{64}(?![\\s\\S])"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
